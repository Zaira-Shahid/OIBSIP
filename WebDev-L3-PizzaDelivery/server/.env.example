# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pizza-delivery?retryWrites=true&w=majority
MONGODB_URI=

# Long random string (used from Module 2). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL where the React app runs (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# --- Needed from Module 3 (Gmail SMTP with App Password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Needed from Module 7 (Razorpay TEST mode keys only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
