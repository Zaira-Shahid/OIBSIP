# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pizza-delivery?retryWrites=true&w=majority
MONGODB_URI=

# Long random string, at least 32 chars (signs login tokens). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# TEMPORARY: set to false in development to let unverified users log in until Module 3.
# Ignored (always true) when NODE_ENV=production.
AUTH_REQUIRE_VERIFIED=true

# Used only by npm run seed:admin (password: 8+ chars, letter + number)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL where the React app runs (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# --- Needed from Module 3 (Gmail SMTP with App Password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Needed from Module 7 (Razorpay TEST mode keys only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
