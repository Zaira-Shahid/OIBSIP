# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pizza-delivery?retryWrites=true&w=majority
MONGODB_URI=

# Long random string, at least 32 chars (signs login tokens). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Used only by npm run seed:admin (password: 8+ chars, letter + number)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL where the React app runs (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# --- Needed from Module 3 (Gmail SMTP with App Password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Low-stock scheduler (Module 10) ---
# Cron expression for how often stock is checked. Default every 15 minutes; use "*/1 * * * *" for a 1-minute demo.
LOW_STOCK_CHECK_CRON=*/15 * * * *
# Where low-stock emails go. Falls back to ADMIN_EMAIL when empty.
ADMIN_ALERT_EMAIL=

# --- Needed from Module 7 (Razorpay TEST mode keys only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
